        },
        {
          "index": 2,
          "image_path": "images/T2_02.png",
          "caption": {
            "zh": "离开并返回后：比较花盆相对于固定建筑的位置。",
            "en": "After leaving and returning: compare the pot’s position relative to the fixed architecture."
          }
        }
      ],
      "name": {
        "zh": "静态属性变化",
