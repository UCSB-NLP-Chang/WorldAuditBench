    "T1": {
      "code": "T1",
      "title": "离开再返回后消失的巨石",
      "definition": {
        "zh": "存在性变化指随时间经过或离开再返回，原本存在的物体无合理原因地消失，或原本不存在的物体突然出现。应回到相近观察位置，排除视角和遮挡造成的可见性差异。",
        "en": "Existence changes occur when an object disappears or appears without a reasonable cause over time or after leaving and returning. Compare similar observation positions to rule out ordinary viewpoint or occlusion differences."
      },
      "evidence": {
        "zh": "离开再返回后，起点旁岸边的巨石消失了，原位置只剩草地。",
        "en": "After leaving and returning, the large boulder beside the starting area disappears, leaving only grass at its shoreline location."
      },
      "frames": [
        {
          "index": 1,
          "image_path": "images/T1_01.png",
          "caption": {
            "zh": "离开前：观察起点旁的巨石与岸线。",
            "en": "Before leaving: observe the boulder beside the starting point and the shoreline."
          }
        },
        {
          "index": 2,
          "image_path": "images/T1_02.png",
          "caption": {
            "zh": "离开并返回后：再次观察原位置。",
            "en": "After leaving and returning: inspect the original location again."
          }
        }
      ],
      "name": {
        "zh": "存在性变化",
        "en": "Existence changes"
      },
      "observation_context": null
    },
