    "S2": {
      "code": "S2",
      "title": "倒置安装的街边邮筒",
      "definition": {
        "zh": "配置不合理指物体符合时代和场景，但其位置、朝向、组合或使用方式违反明确的场景功能或规则。通过调整配置可以解决。",
        "en": "Improper configuration occurs when an object belongs in the era and scene, but its placement, orientation, combination or use conflicts with an established function or rule. Correcting its configuration resolves the conflict."
      },
      "evidence": {
        "zh": "街边的蓝色邮筒被倒置安装，支脚朝上，与旁边正常直立的邮筒不同，无法正常站立使用。",
        "en": "A blue roadside mailbox is installed upside down with its legs pointing upward, unlike the upright mailbox beside it."
      },
      "frames": [
        {
          "index": 1,
          "image_path": "images/S2_01.png",
          "caption": {
            "zh": "比较右侧倒置邮筒与左侧正常邮筒的支脚和朝向。",
            "en": "Compare the legs and orientation of the inverted mailbox on the right with the upright one on the left."
          }
        }
      ],
      "name": {
        "zh": "配置不合理",
        "en": "Improper configuration"
      },
      "observation_context": null
    },
    "S3": {
      "code": "S3",
      "title": "古代茶馆里的现代可乐瓶",
      "definition": {
        "zh": "时代不相容指物体或技术与场景明确建立的历史时代不符，且没有穿越、架空或展览等设定解释。",
        "en": "Historical incompatibility occurs when an object or technology conflicts with the scene’s established historical era, without an explanation such as time travel, alternate history or an exhibition."
