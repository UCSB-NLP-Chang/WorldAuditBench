  "examples": {
    "G1": {
      "code": "G1",
      "title": "悬空的车间椅子",
      "definition": {
        "en": "Missing support / floating occurs when an object that should rest on the ground or another structure has an unexplained gap beneath its supporting parts.",
        "zh": "缺少支撑／悬空指本应由地面或其他结构支撑的物体，与支撑面之间出现不合理的空隙。"
      },
      "evidence": {
        "zh": "车间里的椅子悬在地面上方，椅脚没有接触地面，下面也没有支撑物。",
        "en": "A workshop chair floats above the floor: its legs do not touch the ground and nothing supports it."
      },
      "frames": [
        {
          "index": 1,
          "image_path": "images/G1_01.png",
          "caption": {
            "en": "Side view of the chair legs and the floor below.",
            "zh": "从侧面观察椅脚和下方地面。"
          }
        }
      ],
      "name": {
        "en": "Missing support / floating",
        "zh": "缺少支撑／悬空"
      },
      "observation_context": null
    },
    "G2": {
      "code": "G2",
      "title": "两个垃圾箱相互穿插",
      "definition": {
        "en": "Intersection / overlap / structural misalignment occurs when solid objects penetrate each other, duplicate the same volume, or have incorrectly aligned parts. Multiple viewpoints help establish their spatial relationship.",
        "zh": "穿插／重叠／结构错位指实体物体互相穿入、重复占据同一空间，或本应衔接的部件位置不合理。需要结合不同视角判断实际空间关系。"
      },
      "evidence": {
        "zh": "两个绿色垃圾箱斜向穿插，箱壁和上沿互相穿过，占据了同一片空间。",
        "en": "Two green dumpsters intersect at an angle, with their walls and upper rims passing through one another."
      },
      "frames": [
        {
          "index": 1,
          "image_path": "images/G2_01.png",
          "caption": {
            "en": "Front view of the intersecting green dumpsters.",
            "zh": "正面观察两个绿色垃圾箱。"
          }
        },
        {
          "index": 2,
          "image_path": "images/G2_02.png",
          "caption": {
            "en": "Second angle showing the overlapping walls and rims.",
            "zh": "换一个角度确认箱壁和上沿的穿插。"
          }
        }
      ],
      "name": {
        "en": "Intersection / overlap / structural misalignment",
        "zh": "穿插／重叠／结构错位"
      },
      "observation_context": null
    },
    "G3": {
      "code": "G3",
      "title": "横向压窄的咖啡馆椅子",
      "definition": {
        "en": "Scale / proportion mismatch occurs when an object has an implausible size relative to scene references or distorted proportions between its dimensions.",
        "zh": "尺度／比例失调指物体相对于场景参照物的尺寸明显不合理，或自身长、宽、高的比例失真。"
      },
      "evidence": {
        "zh": "咖啡桌旁的一把椅子高度正常，但座面、椅背和椅脚间距被横向压窄，比例明显不同于旁边的同款椅子。",
        "en": "A chair beside the cafe table has normal height, but its seat, back and leg spacing are compressed sideways compared with the matching chairs nearby."
      },
      "frames": [
        {
          "index": 1,
          "image_path": "images/G3_01.png",
          "caption": {
            "en": "Compare the narrow chair left of the table with the matching chairs.",
            "zh": "比较桌子左侧的窄椅子和周围同款椅子。"
          }
        },
        {
          "index": 2,
          "image_path": "images/G3_02.png",
          "caption": {
            "en": "A second angle confirms its narrow width while the height is unchanged.",
            "zh": "从第二个角度确认椅子宽度异常而高度正常。"
          }
        }
      ],
      "name": {
        "en": "Scale / proportion mismatch",
        "zh": "尺度／比例失调"
      },
      "observation_context": null
    },
    "C1": {
      "code": "C1",
      "title": "穿过完整铁丝网",
      "definition": {
        "en": "Missing collision occurs when a player or object passes through a solid surface that should block movement. Movement actions and before-and-after viewpoints are needed to establish the crossing.",
        "zh": "应阻挡而发生穿透指人物或物体能够穿过本应阻挡移动的实体表面。判断时需要结合移动操作和穿越前后的视点。"
      },
      "evidence": {
        "zh": "人物可以直接穿过完整的铁丝网围栏，而这片围栏应当阻挡通行。",
        "en": "The player can walk straight through an intact wire fence that should block passage."
      },
      "frames": [
        {
          "index": 1,
          "image_path": "images/C1_01.png",
          "caption": {
            "en": "Before moving, face the intact wire fence.",
            "zh": "移动前，正对完整铁丝网。"
          }
        },
        {
          "index": 2,
          "image_path": "images/C1_02.png",
          "caption": {
            "en": "Walk forward 3 m through the fence, with no turn or detour.",
            "zh": "不转向、不绕路，直行 3 米穿过围栏。"
          }
        },
        {
          "index": 3,
          "image_path": "images/C1_03.png",
          "caption": {
            "en": "After crossing, turn 135° in place to look back obliquely: the nearby fence and posts are now visible with the road on the other side.",
            "zh": "穿过后原地转身 135° 向后侧回看：近处铁丝网和木桩清晰可见，道路位于围栏另一侧。"
          }
        }
      ],
      "name": {
        "en": "Missing collision",
        "zh": "应阻挡而发生穿透"
      },
      "observation_context": null
    },
    "C2": {
      "code": "C2",
      "title": "空路面上的空气墙",
      "definition": {
        "en": "Unexpected collision occurs when an apparently traversable area blocks movement without a corresponding visible obstacle. Assess the movement command together with the before-and-after views.",
        "zh": "不应阻挡却被阻挡指看起来可通行的区域存在异常碰撞，导致人物或物体无法按预期移动。需要结合移动指令和移动前后的画面判断。"
      },
      "evidence": {
        "zh": "前方路面看起来畅通，却有看不见的障碍挡住人物，无法继续前进。",
        "en": "An invisible obstruction stops the player on a visibly clear stretch of road."
      },
      "frames": [
        {
          "index": 1,
          "image_path": "images/C2_01.png",
          "caption": {
            "en": "After approaching 2 m, face the clear road ahead.",
            "zh": "已前进 2 米，观察前方空路面。"
          }
        },
        {
          "index": 2,
          "image_path": "images/C2_02.png",
          "caption": {
            "en": "Attempt another 2 m forward: only about 12 cm of movement occurs before stopping.",
            "zh": "再次尝试前进 2 米，仅移动约 12 厘米便停住。"
          }
        }
      ],
      "name": {
        "en": "Unexpected collision",
        "zh": "不应阻挡却被阻挡"
      },
      "observation_context": null
    },
    "C3": {
      "code": "C3",
      "title": "碰撞后纵向翻转并倒扣的垃圾桶",
      "definition": {
        "zh": "交互后物体运动轨迹异常指物体受碰撞、推动等交互后，出现与作用力度和物理条件不相称的运动，例如异常翻转、弹飞或持续弹跳。判断应结合交互过程及相同条件下的正常响应。",
        "en": "Abnormal object trajectories after interaction are motions disproportionate to the applied contact and physical conditions, such as excessive overturning, launching or repeated bouncing. Assess the interaction together with the expected response under the same conditions."
      },
      "evidence": {
        "zh": "人物碰到垃圾桶后，桶异常纵向翻转约 180°，最终桶口朝下倒扣；相同碰撞下的正常对照只会倾倒并侧躺停稳。",
        "en": "After player contact, the bin flips vertically by about 180° and settles upside down on its rim; under the same contact, the normal control tips over and settles on its side."
      },
      "frames": [
        {
          "index": 1,
          "image_path": "images/C3_01.png",
          "caption": {
            "zh": "碰撞前：垃圾桶直立，桶口朝上。",
            "en": "Before contact: the bin stands upright with its opening facing upward."
          }
        },
        {
          "index": 2,
          "image_path": "images/C3_02.png",
          "caption": {
            "zh": "正常对照：碰撞后约 90° 倾倒，侧躺并停稳。",
            "en": "Clean control: contact tips the bin about 90° onto its side, where it settles."
          }
        },
        {
          "index": 3,
          "image_path": "images/C3_03.png",
          "caption": {
            "zh": "异常结果：相同碰撞后纵向翻转约 180°，桶口朝下倒扣。",
            "en": "Faulty result: the same contact produces an approximately 180° vertical overturn, leaving the bin upside down on its rim."
          }
        }
      ],
      "name": {
        "en": "Abnormal object trajectories after interaction",
        "zh": "交互后物体运动轨迹异常"
      },
      "observation_context": {
        "zh": "对照条件：相同起始位置、相同向前行走碰撞、随后退开；图 2 为正常对照结果，图 3 为异常结果，不是连续的两个时刻。",
        "en": "Comparison conditions: identical starting positions and forward walking contact, followed by stepping back. Figure 2 is the clean-control result and Figure 3 is the faulty result; they are not consecutive moments in one run."
      }
    },
    "V1": {
      "code": "V1",
      "title": "透过不透明立柱看到长椅",
      "definition": {
        "en": "Visibility anomalies occur when whether an object is visible contradicts the current viewpoint, distance or occlusion. Examples include unobstructed objects incorrectly disappearing or reappearing as the viewpoint or distance changes, and objects remaining visible through opaque occluders.",
        "zh": "可见性异常指物体是否可见不符合当前视角、距离或遮挡关系。包括无遮挡物体随视角或距离变化异常消失／重现，以及被不透明物体挡住时仍然可见。"
      },
      "evidence": {
        "zh": "长椅位于不透明立柱后方，却仍能透过柱子看到座面和椅背；长椅本身没有与柱子穿插。",
        "en": "The seat and back of a bench remain visible through an opaque column, even though the bench is behind the column and does not intersect it."
      },
      "frames": [
        {
          "index": 1,
          "image_path": "images/V1_01.png",
          "caption": {
            "en": "View the bench with the opaque column directly in front of it.",
            "zh": "从立柱挡住长椅的方向观察。"
          }
        },
        {
          "index": 2,
          "image_path": "images/V1_02.png",
          "caption": {
            "en": "Side view establishes the bench’s position behind the column.",
            "zh": "从侧面确认长椅位于柱后且未穿插。"
          }
        }
      ],
      "name": {
        "en": "Visibility anomalies",
        "zh": "可见性异常"
      },
      "observation_context": null
    },
