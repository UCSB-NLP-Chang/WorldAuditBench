+// The cooked clean-window material flashes white on stationary SM5 views.
+// Reuse the house's cooked cabinet glass, preserving transparent panes and frames.
+void StabilizeResidentialWindowGlass(UWorld* World)
+{
+    if (!World || FParse::Param(FCommandLine::Get(), TEXT("AuditorOriginalWindowGlass"))) return;
+    const FString OriginalPath = TEXT("/Game/GameReady3D/AtmosphericFarmhouse/Materials/M_WindowGlass_Clean.M_WindowGlass_Clean");
+    const TCHAR* StablePath = TEXT("/Game/GameReady3D/AtmosphericFarmhouse/Materials/M_Glass_A.M_Glass_A");
+    UMaterialInterface* Stable = nullptr;
+    int32 RepairedSlots = 0;
+    for (TActorIterator<AActor> It(World); It; ++It)
+    {
+        TInlineComponentArray<UStaticMeshComponent*> Components;
+        It->GetComponents(Components);
+        for (UStaticMeshComponent* Component : Components)
+        {
+            for (int32 Slot = 0; Slot < Component->GetNumMaterials(); ++Slot)
+            {
+                UMaterialInterface* Material = Component->GetMaterial(Slot);
+                if (!Material || Material->GetPathName() != OriginalPath) continue;
+                if (!Stable)
+                {
+                    Stable = LoadObject<UMaterialInterface>(nullptr, StablePath);
+                    if (!Stable || Stable->GetBlendMode() != BLEND_Translucent)
+                    {
+                        UE_LOG(LogTemp, Warning, TEXT("AUDITOR_WINDOW_GLASS_REPAIR unavailable; retaining original glass"));
+                        return;
+                    }
+                }
+                Component->SetMaterial(Slot, Stable);
+                ++RepairedSlots;
+            }
+        }
+    }
+    if (RepairedSlots)
+        UE_LOG(LogTemp, Display, TEXT("AUDITOR_WINDOW_GLASS_REPAIR slots=%d material=%s"), RepairedSlots, StablePath);
+}
